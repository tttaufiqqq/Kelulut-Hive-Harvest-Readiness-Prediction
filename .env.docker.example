# Copy to .env.docker (ignored by git) and fill in APP_KEY:
#   docker compose run --rm --no-deps app php artisan key:generate --show

APP_KEY=
APP_URL=http://localhost:8080

DB_DATABASE=buzzyhive
DB_USERNAME=hive
DB_PASSWORD=change-me-locally
DB_ROOT_PASSWORD=change-me-too

# Local stand-ins. Real values only when you want to test those integrations.
IOT_API_KEY=local-dev-key
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
TELEGRAM_BOT_TOKEN=
