{
	# One container, one process, no admin API and no certificate handling:
	# Azure Container Apps ingress terminates TLS in front of this.
	admin off
	auto_https off
	frankenphp
	order php_server before file_server
}

:8080 {
	root * /app/public
	encode zstd gzip

	# Long-lived caching for the fingerprinted Vite output.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	header -Server

	php_server
}
